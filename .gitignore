# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
release/
build/

# Environment files
*.env
.env.local
.env.production

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Electron build files
*.exe
*.dmg
*.app
*.zip
*.blockmap

# Uploads (except .gitkeep)
server/uploads/**/*
!server/uploads/.gitkeep
!server/uploads/members/.gitkeep

# Server-owned: published desktop builds (exe + manifest), not source.
backend/desktop/
# generated by scripts/install-service.ps1, served at /version.json
backend/build-info.json
# Windows service logs written by NSSM (scripts/install-service.ps1)
backend/logs/

# Impeccable (design agent) — vendored tool, installed per-machine via
# `npx impeccable skills install -y --providers=claude --scope=project`,
# updated via `npx impeccable skills update`. The design *context* it reads
# (PRODUCT.md, DESIGN.md, .impeccable/config.json, .impeccable/design.json)
# IS committed; the tool, its agents, and per-developer state are not.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.ndjson
.impeccable/live/
